# ============================================================
# AI Fresher Job Hunter — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── OpenAI ────────────────────────────────────────────────
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SerpAPI ───────────────────────────────────────────────
# Get yours at: https://serpapi.com/manage-api-key
# Free plan: 100 searches/month
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── RapidAPI (JSearch) ────────────────────────────────────
# Subscribe at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free plan: 200 requests/month
RAPIDAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Apify (optional, reserved for future) ─────────────────
APIFY_TOKEN=

# ── Email ─────────────────────────────────────────────────
# EMAIL_USER: your Gmail address
# EMAIL_PASS: 16-character App Password (NOT your login password)
# How to generate App Password:
#   Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
MY_EMAIL=recipient@gmail.com

# ── Telegram (optional) ───────────────────────────────────
# Create bot: https://t.me/BotFather → /newbot
# Get Chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheets (optional) ──────────────────────────────
# GOOGLE_SHEETS_ID: The spreadsheet ID from its URL
# GOOGLE_SERVICE_ACCOUNT_JSON: Base64-encoded service account key JSON
#   Encode: base64 -i service_account.json | tr -d '\n'
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── App Settings ──────────────────────────────────────────
LOG_LEVEL=INFO
# Maximum jobs fetched per query per source (keep ≤25 to manage cost)
MAX_JOBS_PER_SOURCE=25
# Minimum AI score to include a job in the report (0–100)
MIN_AI_SCORE=40
# Number of top jobs to include in the email
TOP_JOBS_IN_EMAIL=20
